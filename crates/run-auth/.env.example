# Local development only. Do not enable insecure HTTP in production.
AUTH_ALLOW_INSECURE_HTTP=true
AUTH_ALLOWED_ORIGIN=http://localhost:3000
AUTH_BIND_ADDRESS=127.0.0.1
AUTH_API_PORT=3000
AUTH_DB_PATH=crates/run-auth/data/auth.db
AUDIT_LOG_DIR=crates/run-auth/logs

# Production examples:
# AUTH_ALLOW_INSECURE_HTTP=false
# AUTH_ALLOWED_ORIGIN=https://auth.example.com
# AUTH_TRUSTED_PROXY_IPS=10.0.0.8

# LAN development example, reachable from another device on the same network:
# AUTH_BIND_ADDRESS=0.0.0.0
# AUTH_ALLOWED_ORIGIN=http://192.168.1.101:3000
