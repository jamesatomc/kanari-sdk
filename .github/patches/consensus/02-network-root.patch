+// Copyright (c) KanariNetwork, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Canonical account-free root for object protocol checkpoints.
+
+use crate::state::StateManager;
+use anyhow::{Context, Result};
+use std::collections::BTreeMap;
+
+fn included(key: &[u8]) -> bool {
+    key.starts_with(b"object:")
+        || key.starts_with(b"owned_objects:")
+        || key.starts_with(b"df:")
+        || key.starts_with(b"system:")
+        || key.starts_with(b"supply:")
+        || key.starts_with(b"treasury:")
+        || key.starts_with(b"nft:")
+        || key.starts_with(b"collection_members:")
+        || key.starts_with(b"metadata_")
+        || key == b"total_supply"
+        || key == b"global_token_supplies"
+        || key == b"treasury_index"
+        || key == b"nft_collection_index"
+        || key == b"object_locked_coin_records"
+}
+
+impl StateManager {
+    pub fn compute_object_state_root(&self) -> Result<Vec<u8>> {
+        let mut entries: BTreeMap<Vec<u8>, Vec<u8>> = self
+            .store
+            .logical_entries()
+            .context("Failed to read object state entries")?
+            .into_iter()
+            .filter(|(key, _)| included(key))
+            .collect();
+        for (key, value) in &self.overlay {
+            if !included(key) {
+                continue;
+            }
+            match value {
+                Some(value) => {
+                    entries.insert(key.clone(), value.clone());
+                }
+                None => {
+                    entries.remove(key);
+                }
+            }
+        }
+        Ok(smt::compute_sparse_root(&entries.into_iter().collect::<Vec<_>>()).to_vec())
+    }
+}
