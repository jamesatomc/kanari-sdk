+//! Atomic persistence for object state plus non-consensus bookkeeping.
+
+use crate::state::StateManager;
+use anyhow::Result;
+
+impl StateManager {
+    pub fn commit_object_transition(
+        &mut self,
+        mut auxiliary_updates: Vec<(Vec<u8>, Vec<u8>)>,
+        mut auxiliary_deletes: Vec<Vec<u8>>,
+    ) -> Result<()> {
+        for (key, value) in &self.overlay {
+            match value {
+                Some(value) => auxiliary_updates.push((key.clone(), value.clone())),
+                None => auxiliary_deletes.push(key.clone()),
+            }
+        }
+        auxiliary_updates.sort_by(|left, right| left.0.cmp(&right.0));
+        auxiliary_updates.dedup_by(|left, right| left.0 == right.0);
+        auxiliary_deletes.sort();
+        auxiliary_deletes.dedup();
+        self.store
+            .apply_raw_changes(&auxiliary_updates, &auxiliary_deletes)?;
+        self.overlay.clear();
+        Ok(())
+    }
+}
